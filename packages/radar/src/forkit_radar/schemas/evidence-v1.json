{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "axis": {
      "enum": [
        "discovery",
        "association",
        "passport",
        "artifact",
        "provenance",
        "runtime",
        "acceptance",
        "freshness"
      ],
      "title": "Axis",
      "type": "string"
    },
    "state": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "State",
      "type": "string"
    },
    "basis": {
      "enum": [
        "none",
        "declared",
        "supported_metadata",
        "independently_measured",
        "os_peer",
        "local_authority",
        "external_verifier",
        "adapter_report",
        "core_identity_check"
      ],
      "title": "Basis",
      "type": "string"
    },
    "logical_agent_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Logical Agent Id"
    },
    "passport_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Passport Id"
    },
    "revision_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revision Digest"
    },
    "instance_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Instance Id"
    },
    "authority_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authority Id"
    },
    "scope_profile": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Scope Profile",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Reason Code",
      "type": "string"
    },
    "checked_at": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checked At"
    },
    "expires_at": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "supporting_evidence_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxLength": 256,
      "title": "Supporting Evidence Ids",
      "type": "array"
    },
    "verifier_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Verifier Version",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Policy Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "axis",
    "state",
    "basis",
    "logical_agent_id",
    "passport_id",
    "revision_digest",
    "instance_id",
    "authority_id",
    "scope_profile",
    "reason_code",
    "checked_at",
    "expires_at",
    "supporting_evidence_ids",
    "verifier_version",
    "policy_version"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
