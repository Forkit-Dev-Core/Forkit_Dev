{
  "$defs": {
    "ArtifactMetadata": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "tree",
            "config_bundle",
            "model_metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/ObservedDigest"
        },
        "hashing_profile": {
          "enum": [
            "core-file-sha256-v1",
            "core-directory-sha256-v1",
            "manifest-sha256-v1",
            "unknown"
          ],
          "title": "Hashing Profile",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "digest",
        "hashing_profile"
      ],
      "title": "ArtifactMetadata",
      "type": "object"
    },
    "DeclaredIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ObservedText"
        },
        "version": {
          "$ref": "#/$defs/ObservedText"
        },
        "creator": {
          "$ref": "#/$defs/ObservedText"
        },
        "organization": {
          "$ref": "#/$defs/ObservedText"
        }
      },
      "required": [
        "name",
        "version",
        "creator",
        "organization"
      ],
      "title": "DeclaredIdentity",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "logical_agent_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Logical Agent Id"
        },
        "provisional_component_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provisional Component Key"
        },
        "passport_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Passport Id"
        },
        "component_kind": {
          "enum": [
            "agent",
            "model",
            "application",
            "runtime",
            "tool",
            "mcp_server"
          ],
          "title": "Component Kind",
          "type": "string"
        },
        "scope_profile": {
          "$ref": "#/$defs/ScopeProfile"
        },
        "declared_identity": {
          "$ref": "#/$defs/DeclaredIdentity"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolMetadata"
              },
              "maxLength": 256,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tools"
        },
        "models": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ModelReference"
              },
              "maxLength": 256,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Models"
        },
        "artifacts": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ArtifactMetadata"
              },
              "maxLength": 256,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifacts"
        },
        "settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/Settings"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_completeness": {
          "$ref": "#/$defs/MeasurementCompleteness"
        }
      },
      "required": [
        "schema_version",
        "logical_agent_id",
        "provisional_component_key",
        "passport_id",
        "component_kind",
        "scope_profile",
        "declared_identity",
        "tools",
        "models",
        "artifacts",
        "settings",
        "measurement_completeness"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "MeasurementCompleteness": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unsupported",
            "not_selected"
          ],
          "title": "Identity",
          "type": "string"
        },
        "tools": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unsupported",
            "not_selected"
          ],
          "title": "Tools",
          "type": "string"
        },
        "models": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unsupported",
            "not_selected"
          ],
          "title": "Models",
          "type": "string"
        },
        "artifacts": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unsupported",
            "not_selected"
          ],
          "title": "Artifacts",
          "type": "string"
        },
        "settings": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unsupported",
            "not_selected"
          ],
          "title": "Settings",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "tools",
        "models",
        "artifacts",
        "settings"
      ],
      "title": "MeasurementCompleteness",
      "type": "object"
    },
    "ModelReference": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "origin": {
          "enum": [
            "unknown",
            "declared",
            "supported_metadata",
            "independently_measured"
          ],
          "title": "Origin",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/ObservedText"
        },
        "version": {
          "$ref": "#/$defs/ObservedText"
        },
        "provider": {
          "$ref": "#/$defs/ObservedText"
        },
        "passport_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Passport Id"
        },
        "digest": {
          "$ref": "#/$defs/ObservedDigest"
        }
      },
      "required": [
        "key",
        "origin",
        "name",
        "version",
        "provider",
        "passport_id",
        "digest"
      ],
      "title": "ModelReference",
      "type": "object"
    },
    "ObservedDigest": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "origin": {
          "enum": [
            "unknown",
            "declared",
            "supported_metadata",
            "independently_measured"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "value",
        "origin"
      ],
      "title": "ObservedDigest",
      "type": "object"
    },
    "ObservedText": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "origin": {
          "enum": [
            "unknown",
            "declared",
            "supported_metadata",
            "independently_measured"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "value",
        "origin"
      ],
      "title": "ObservedText",
      "type": "object"
    },
    "ScopeProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "enum": [
            "passive-metadata-v1",
            "consented-artifacts-v1",
            "runtime-adapter-v1"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "normalization_version": {
          "const": "1",
          "title": "Normalization Version",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "enum": [
              "identity",
              "tools",
              "models",
              "artifacts",
              "settings"
            ],
            "type": "string"
          },
          "maxLength": 256,
          "title": "Dimensions",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "normalization_version",
        "dimensions"
      ],
      "title": "ScopeProfile",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "unknown",
            "declared",
            "supported_metadata",
            "independently_measured"
          ],
          "title": "Origin",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,2})(\\.[0-9]{1,8})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]{0,2})(\\.[0-9]{1,8})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top P"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Tokens"
        }
      },
      "required": [
        "origin",
        "temperature",
        "top_p",
        "max_tokens"
      ],
      "title": "Settings",
      "type": "object"
    },
    "ToolMetadata": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/ObservedText"
        },
        "origin": {
          "enum": [
            "unknown",
            "declared",
            "supported_metadata",
            "independently_measured"
          ],
          "title": "Origin",
          "type": "string"
        },
        "transport": {
          "enum": [
            "stdio",
            "http",
            "in_process",
            "unknown"
          ],
          "title": "Transport",
          "type": "string"
        },
        "permissions": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "read_metadata",
                  "read_files",
                  "write_files",
                  "network",
                  "execute"
                ],
                "type": "string"
              },
              "maxLength": 256,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Permissions"
        }
      },
      "required": [
        "key",
        "name",
        "origin",
        "transport",
        "permissions"
      ],
      "title": "ToolMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "observation_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Observation Id",
      "type": "string"
    },
    "source_slot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Source Slot Id",
      "type": "string"
    },
    "observed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Observed At",
      "type": "string"
    },
    "detector_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Detector Id",
      "type": "string"
    },
    "detector_version": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Detector Version",
      "type": "string"
    },
    "source_status": {
      "enum": [
        "complete",
        "partial",
        "denied",
        "missing",
        "unsupported",
        "timeout",
        "malformed"
      ],
      "title": "Source Status",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Reason Code",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Manifest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "source_slot_id",
    "observed_at",
    "detector_id",
    "detector_version",
    "source_status",
    "reason_code",
    "manifest"
  ],
  "title": "Observation",
  "type": "object"
}
